# Accounts remain unavailable unless explicitly enabled for isolated staging.
NEXT_PUBLIC_ENABLE_STAGING_ACCOUNTS=false
NEXT_PUBLIC_SUPABASE_URL=https://mibydnerayobemhnlfyl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy browser anon key is supported if no publishable key is supplied.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to preview in Vercel Preview. Never enable accounts in Production.
NEXT_PUBLIC_VERCEL_ENV=
# RevenueCat Test Store public SDK key for isolated Preview only. Use a separate
# approved web billing public key and server-side verification for production.
NEXT_PUBLIC_REVENUECAT_PUBLIC_KEY=
# Preview purchase mode: test_store (default) or billing_sandbox. Neither mode
# is available in Production. The billing sandbox key begins with rcb_sb_.
NEXT_PUBLIC_REVENUECAT_PREVIEW_STORE=test_store
NEXT_PUBLIC_REVENUECAT_BILLING_SANDBOX_KEY=
