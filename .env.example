# Accounts remain unavailable unless explicitly enabled for isolated staging.
NEXT_PUBLIC_ENABLE_STAGING_ACCOUNTS=false
NEXT_PUBLIC_SUPABASE_URL=https://mibydnerayobemhnlfyl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy browser anon key is supported if no publishable key is supplied.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Production requires an approved project, its exact ref, and explicit activation.
# Leave disabled until RLS, roles, SMTP and hosted confirmation/recovery are verified.
NEXT_PUBLIC_ENABLE_PRODUCTION_ACCOUNTS=false
NEXT_PUBLIC_PRODUCTION_SUPABASE_REF=
# Required only when explicitly promoting the existing ARO project to production.
NEXT_PUBLIC_PROMOTE_EXISTING_ARO=false
# Next config derives this from VERCEL_ENV on Vercel; local development may leave it empty.
NEXT_PUBLIC_VERCEL_ENV=

# AUTH3: keep disabled until the new migration, worker and hosted journeys pass review.
NEXT_PUBLIC_ENABLE_ACCOUNT_LIFECYCLE=false
ENABLE_ACCOUNT_DELETION_WORKER=false
# Server-only credentials. Never use NEXT_PUBLIC_ for these values.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVER_PROJECT_REF=
CRON_SECRET=
